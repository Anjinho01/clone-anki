# See https://help.github.com/ignore-files/ for more about ignoring files.

# Dependencies
/node_modules
/.yarn
package-lock.json
yarn.lock
pnpm-lock.yaml

# Testing
/coverage

# Production
/build
/dist

# Environment variables
.env
.env.local
.env.*.local

# Keep base environment configs (commitable)
!.env.development
!.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Cache
.eslintcache
.cache
.webpack_cache

# OS
.DS_Store
Thumbs.db

# IDE
/.idea
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json

# Webpack
stats.json

# TypeScript
*.tsbuildinfo

# Misc
/src/styles/tailwind.css

# Yarn
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
