# ===================================
# 🔧 CONFIGURAÇÃO DE DESENVOLVIMENTO
# ===================================

# 🎯 Base URL (deixe vazio para root '/')
# Exemplos: /app, /auth, /financeiro, /contas/add
PUBLIC_URL=

# 🌐 Domínio de produção (não usado em dev)
DOMAIN=http://localhost

# 🔌 Porta do servidor de desenvolvimento
PORT=8377

# 🔗 URL da API backend
API_URL=http://localhost:3007

# 🤖 reCAPTCHA v3 Site Key (desativado em dev — deixe vazio)
RECAPTCHA_SITE_KEY=

# 📡 Proxy - Rotas que devem ser redirecionadas para o backend
# Separadas por vírgula
PROXY_ROUTES=

# 🎯 Target do proxy (servidor backend)
PROXY_TARGET=http://localhost:3007
