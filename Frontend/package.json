  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development webpack serve --open --config webpack/webpack.development.js",
    "build": "rimraf node_modules/.cache .cache build && cross-env NODE_ENV=production webpack --config webpack/webpack.production.js",
    "build:analyze": "rimraf node_modules/.cache .cache build && cross-env NODE_ENV=production ANALYZE=true webpack --config webpack/webpack.production.js",
    "analyze": "cross-env NODE_ENV=production webpack --config webpack/webpack.production.js --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "clean": "rimraf package-lock.json node_modules build .webpack_cache",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx}",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
