# ===================================
# 🔧 CONFIGURAÇÃO DE PRODUÇÃO
# ===================================

# 🎯 Base URL (deixe vazio para root '/')
# Exemplos: /app, /auth, /financeiro, /contas/add
PUBLIC_URL=

# 🌐 Domínio de produção
DOMAIN=https://flashcard.dombarreto.com

# 🔌 Porta (não usado em produção)
PORT=8377

# 🔗 URL da API backend (produção)
API_URL=https://flashcard-api.dombarreto.com

# 🤖 reCAPTCHA v3 Site Key
RECAPTCHA_SITE_KEY=

# 📡 Proxy - Não usado em produção (build estático)
PROXY_ROUTES=

# 🎯 Target do proxy - Não usado em produção
PROXY_TARGET=https://flashcard-api.dombarreto.com
