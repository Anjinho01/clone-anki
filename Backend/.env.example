# ==============================================
# CONFIGURAÇÃO DO AMBIENTE - Flashcards API
# ==============================================

# Log
LOG_LEVEL=info

# ----------------------------------------------
# Ambiente
# ----------------------------------------------
NODE_ENV=development            # development | production | test

# Servidor
PORT=3000
HOST=0.0.0.0

# ----------------------------------------------
# Banco de Dados (MySQL)
# ----------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=flashcards
DB_PASSWORD=sua_senha_aqui
DB_NAME=flashcards_db
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# ----------------------------------------------
# JWT (JSON Web Tokens)
# ----------------------------------------------
# IMPORTANTE: Altere os secrets em produção!
# Use pelo menos 32 caracteres aleatórios.
JWT_SECRET=gere_um_secret_forte_de_256_bits
JWT_REFRESH_SECRET=gere_outro_secret_forte_de_256_bits
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

# ----------------------------------------------
# reCAPTCHA (Google)
# ----------------------------------------------
# reCAPTCHA v3 (invisível, baseado em score)
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# reCAPTCHA v2 — Fallback visual (checkbox "Não sou um robô")
# Quando o score do v3 está abaixo do MIN_SCORE, o sistema exibe
# o challenge visual v2 para o usuário provar que é humano.
# Obtenha as chaves v2 em: https://www.google.com/recaptcha/admin
# Tipo: reCAPTCHA v2 → "I'm not a robot" Checkbox
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=

# ----------------------------------------------
# SMTP/Email (para reset de senha)
# ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_app_password
SMTP_FROM="Flashcards <noreply@flashcards.com>"

# ----------------------------------------------
# CORS e Cookies
# ----------------------------------------------
# Múltiplas origens separadas por vírgula
CORS_ORIGINS=http://localhost:5171,http://localhost:3000

# Para cookies cross-site (domínios diferentes)
CROSS_SITE_COOKIES=false
COOKIE_DOMAIN=
ENABLE_SWAGGER=true

# Seed inicial de usuarios privilegiados
# Mantenha false por padrao e habilite apenas quando precisar bootstrap explicito.
SEED_DEFAULT_USERS=false
SEED_DEVELOP_EMAIL=
SEED_DEVELOP_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Importacao do Brainscape
# Se o arquivo existir, a migration tentara importar automaticamente os packs/decks/cards.
BRAINSCAPE_EXPORT_PATH=
BRAINSCAPE_IMPORT_TAG=brainscape:2026-04-25
BRAINSCAPE_IMPORT_ACTOR_EMAIL=brainscape-import@local.invalid

# ----------------------------------------------
# Proxy Reverso (Nginx, Apache, etc)
# ----------------------------------------------
# Se estiver atrás de um proxy reverso, configure para rate limiting correto
# Valores aceitos:
#   0 ou false  = Sem proxy (desenvolvimento local)
#   1           = 1 proxy (Nginx na frente da aplicação) - RECOMENDADO para produção
#   2+          = Múltiplos proxies em cadeia
#   true        = Confia em qualquer proxy (NÃO RECOMENDADO - risco de bypass)
#
# Em produção com Nginx: use TRUST_PROXY=1
TRUST_PROXY=0                   # 1 se usar proxy reverso

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
#
# 1. Nunca commite o arquivo .env no git!
# 2. Em produção, use um gerenciador de secrets
#    (AWS Secrets Manager, HashiCorp Vault, etc)
# 3. Certifique-se de alterar JWT_SECRET em produção
# 4. Configure SMTP corretamente para funcionar
#    o reset de senha
# 5. Em produção com HTTPS, configure cookies
#    adequadamente (secure=true)
#
# ==============================================
