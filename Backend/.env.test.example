# ==============================================
# CONFIGURAÇÃO DE AMBIENTE DE TESTES
# ==============================================

# ----------------------------------------------
# Ambiente
# ----------------------------------------------
NODE_ENV=test
PORT=9999
HOST=127.0.0.1
LOG_LEVEL=error

# ----------------------------------------------
# Banco de Dados (MySQL — não usado em testes unitários)
# ----------------------------------------------
# Os testes unitários mockam o banco. Estas variáveis
# existem apenas para satisfazer imports do env.ts.
# Para testes de integração, configure um banco separado.
DB_HOST=localhost
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test
DB_NAME=flashcards_test
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT=5000

# ----------------------------------------------
# JWT (valores fake para testes)
# ----------------------------------------------
# ATENÇÃO: Não use estes valores em produção!
JWT_SECRET=test-jwt-secret-32chars-minimum!!
JWT_REFRESH_SECRET=test-jwt-refresh-secret-32chars!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

# ----------------------------------------------
# CORS e Cookies
# ----------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_DOMAIN=
CROSS_SITE_COOKIES=false
ENABLE_SWAGGER=false
SEED_DEFAULT_USERS=false
SEED_DEVELOP_EMAIL=
SEED_DEVELOP_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
BRAINSCAPE_EXPORT_PATH=
BRAINSCAPE_IMPORT_TAG=brainscape:2026-04-25
BRAINSCAPE_IMPORT_ACTOR_EMAIL=brainscape-import@local.invalid

# ----------------------------------------------
# reCAPTCHA (vazio = bypass automático em test)
# ----------------------------------------------
# Quando NODE_ENV=test, as funções verifyRecaptcha/verifyRecaptchaV2
# retornam sucesso automaticamente, sem chamar a API do Google.
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ----------------------------------------------
# SMTP (não usado em testes unitários)
# ----------------------------------------------
# Para testes de integração com email, considere
# usar serviços fake como Mailtrap ou MailHog.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@flashcards.test

# ----------------------------------------------
# Proxy Reverso
# ----------------------------------------------
TRUST_PROXY=false

# ==============================================
# NOTAS IMPORTANTES
# ==============================================
#
# 1. Este arquivo deve ser usado apenas para testes
# 2. Configure um banco de dados separado para testes
# 3. Use credenciais de teste, não de produção
# 4. Considere usar serviços de email fake (Mailtrap, MailHog)
# 5. O NODE_ENV=test desabilita certos recursos de segurança
#    (reCAPTCHA bypass, etc)
#
# ==============================================
