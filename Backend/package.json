{
  "name": "flashcards-api",
  "version": "1.0.0",
  "description": "API REST para o Flashcards — sistema de repetição espaçada com FSRS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "migration": "ts-node-dev src/database/migration.ts",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest --testPathPattern=test/unit --runInBand",
    "test:coverage": "jest --runInBand --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --detectOpenHandles --coverage --ci --forceExit"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^8.0.5",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "ts-fsrs": "^4.6.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "nock": "^14.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
